# Application Settings
PROJECT_NAME="PADH LE BC (Break the Code)"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=true

# Database Settings
DATABASE_URL="sqlite:///./padh_le_bc.db"

# Storage Settings
